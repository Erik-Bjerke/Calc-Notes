# Numori Notes - Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret (REQUIRED - Change in production!)
JWT_SECRET=dev-secret-do-not-use-in-production

# Database (PostgreSQL)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS allowed origins (comma-separated, leave empty to allow all in dev)
# Capacitor origins (https://localhost, capacitor://localhost) are always included.
# e.g. https://notes.numori.app
CORS_ORIGINS=

# SMTP (for email verification & password recovery)
# Leave SMTP_HOST empty to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@numori.app

# API Base URL (leave empty for web, set for native Capacitor builds)
# e.g. https://notes.numori.app
NUXT_PUBLIC_API_BASE=

# Collaborative editing (Automerge sync)
#
# Real-time collaboration is served by numori-crdt, a separate deployment that
# can host several apps at once. This app registers there as "notes", so clients
# connect to wss://<crdt-host>/notes. Configure that app with the same
# JWT_SECRET as above and it will verify the capability tokens this API mints.
#
# Public WebSocket URL the browser/app uses to reach the sync service. The path
# must name this app, since the service hosts several and refuses a path naming
# none of them:
#   wss://crdt.numori.app/notes   (production)
#   ws://localhost:3030/notes     (development)
# Leave empty on web to derive `${origin}/collab/notes` — reverse-proxy /collab/
# to the numori-crdt deployment, stripping that prefix. REQUIRED for native
# (Capacitor) and Electron builds, whose capacitor:// / app:// origins cannot be
# turned into a WebSocket URL.
NUXT_PUBLIC_COLLAB_WS_URL=

# Admin API of the sync service, used to disconnect peers the moment a share's
# access changes (member kicked, share deleted, switched to private). Without it,
# access changes only take effect when the peer's token expires.
# CRDT_ADMIN_URL is the service's base url; CRDT_ADMIN_SECRET is its
# CRDT_ADMIN_SECRET (or the app's own adminSecret). Server-side only — never
# expose these to the client.
CRDT_ADMIN_URL=
CRDT_ADMIN_SECRET=
# App id registered in the sync service's registry (defaults to "notes").
# CRDT_APP_ID=notes

# Shared secret for POST /api/collab/authorize, the endpoint the sync service
# calls to ask whether a peer may join a document. Answering from live
# shared_notes / share_members state is what stops a kicked member or a deleted
# share from syncing until their token expires. Set the same value as the app's
# webhookSecretEnv in the sync service's registry; without it the endpoint
# refuses every request.
CRDT_WEBHOOK_SECRET=

# Store links for native app update notifications
# When a new version is detected on native, users are directed to the store
NUXT_PUBLIC_STORE_ANDROID=
NUXT_PUBLIC_STORE_IOS=
