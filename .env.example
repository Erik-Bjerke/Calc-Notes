# Numori Notes - Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret (REQUIRED - Change in production!)
JWT_SECRET=dev-secret-do-not-use-in-production

# Database (PostgreSQL)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS allowed origins (comma-separated, leave empty to allow all in dev)
# Capacitor origins (https://localhost, capacitor://localhost) are always included.
# e.g. https://notes.numori.app
CORS_ORIGINS=

# SMTP (for email verification & password recovery)
# Leave SMTP_HOST empty to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@numori.app

# API Base URL (leave empty for web, set for native Capacitor builds)
# e.g. https://notes.numori.app
NUXT_PUBLIC_API_BASE=

# Collaborative editing (Automerge sync service)
# Public WebSocket URL the browser/app uses to reach the collab sync service.
# Leave empty on web to derive `${origin}/collab` (reverse-proxy /collab -> collab:3030).
# REQUIRED for native (Capacitor) and Electron builds — their capacitor:// / app://
# origins cannot be turned into a WebSocket URL, so set this explicitly, e.g.
#   wss://notes.numori.app/collab   (production)
#   ws://localhost:3030             (development)
# (If NUXT_PUBLIC_API_BASE is an https URL it is used to derive wss://<base>/collab.)
NUXT_PUBLIC_COLLAB_WS_URL=
#
# --- Collab sync service (collab-server/, runs as its own process) ---
# The service reuses JWT_SECRET (to verify capability tokens minted by the API)
# and the POSTGRES_* variables above (to store collaborative documents).
COLLAB_PORT=3030
COLLAB_HOST=0.0.0.0
# Document storage backend: "postgres" for durability, empty = in-memory only.
COLLAB_STORAGE=postgres
# Require a valid capability token on every connection. Set to "false" only for
# local development / trusted networks.
COLLAB_REQUIRE_AUTH=true
# Evict idle documents from memory after this many ms (0 disables). Idle rooms
# stay durable in Postgres and reload on next access; keeps memory bounded.
COLLAB_IDLE_EVICT_MS=300000

# Store links for native app update notifications
# When a new version is detected on native, users are directed to the store
NUXT_PUBLIC_STORE_ANDROID=
NUXT_PUBLIC_STORE_IOS=
