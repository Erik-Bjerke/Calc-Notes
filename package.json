{
  "name": "numori-notes",
  "type": "module",
  "main": "electron/main.js",
  "private": true,
  "version": "0.25.0",
  "description": "Free, open-source notes app with a built-in natural language calculator. Do math as you write, export to multiple formats, and sync with end-to-end encryption.",
  "author": {
    "name": "Erik Bjerke",
    "email": "contact@erikbjerke.com",
    "url": "https://erikbjerke.com"
  },
  "contributors": [
    {
      "name": "Yaiza Wadhwani Valderas",
      "email": "yaizawv@proton.me"
    },
    {
      "name": "TheProcedural Software Ltd",
      "email": "contact@theprocedural.com",
      "url": "https://theprocedural.com"
    }
  ],
  "license": "AGPL-3.0",
  "homepage": "https://github.com/Numori-Ecosystem/Numori-Notes",
  "repository": {
    "type": "git",
    "url": "git@github.com:Numori-Ecosystem/Numori-Notes.git"
  },
  "keywords": [
    "calculator",
    "notepad",
    "natural-language",
    "markdown",
    "open-source",
    "pwa",
    "vue",
    "nuxt"
  ],
  "scripts": {
    "build": "nuxt build",
    "build:app": "nuxt generate && npx cap sync && npx electron-builder --config electron-builder.config.js",
    "build:phones": "nuxt generate && npx cap sync",
    "build:desktop": "nuxt generate && npx electron-builder --config electron-builder.config.js",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "open": "npx cap open android && npx cap open ios",
    "dev": "rm -f public/version.json public/sw.js && nuxt cleanup && nuxt dev --host 0.0.0.0",
    "dev:android": "npx cap run android -l --host localhost --port 3000 --forwardPorts 3000:3000",
    "dev:ios": "npx cap run ios -l --port 3000",
    "dev:desktop": "VITE_DEV_SERVER_URL=http://localhost:3000 npx electron electron/main.js",
    "dev:phones": "concurrently -n android,ios -c green,yellow \"npm run dev:android\" \"npm run dev:ios\"",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:full": "docker compose -f docker-compose.dev.yml up -d && npm run dev:web",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.6.2",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.4.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@zip.js/zip.js": "^2.8.34",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.2.1",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.5.1",
    "nuxt-codemirror": "^0.0.20",
    "pg": "^8.22.0",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
